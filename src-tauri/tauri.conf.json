{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾学",
  "version": "0.2.0",
  "identifier": "com.shiaoming123.shixue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "拾学",
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:study.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEODE2MzgwNkMzNTIzMzEKUldReEl6VnNnR09CTFY3dmY3SlpzU0ZlZWNxSEMzaG9Hdll5MkNBbFlGbzJlQWdqTmV6YWN4THUK",
      "endpoints": [
        "https://github.com/Shiaoming123/shixue/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "bccd6d9c-6ba9-56d2-9f8d-4c35f1ab89a5"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
